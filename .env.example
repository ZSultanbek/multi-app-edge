# Copy to .env before running. Never commit the real .env.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASS=change-me
ALPHA_DB_PASSWORD=change-me-alpha
GAMMA_DB_PASSWORD=change-me-gamma
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
LOG_LEVEL=INFO
